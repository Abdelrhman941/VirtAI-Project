    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remove-markdown": "^0.6.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "0.160.0",
    "three-stdlib": "^2.36.1",
    "vaul": "^1.1.2",
