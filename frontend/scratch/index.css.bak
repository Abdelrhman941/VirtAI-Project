/* stylelint-disable-next-line import-notation */
@import "tailwindcss";

/* stylelint-disable-next-line at-rule-no-unknown */
@plugin "@tailwindcss/typography";

@theme {
  /* Font Family Definitions */
  --font-sans: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-display: 'Cabinet Grotesk', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;

  /* Premium Palette Overrides */
  --color-dark: #0A0908;
  --color-dark-secondary: #121212;
  --color-dark-tertiary: #1a1a1a;
  --color-offwhite: #F5F1EC;
  
  --color-gold: #B4AB8B;
  --color-gold-soft: #C9C0A0;
  --color-gold-deep: #8E866B;

  --color-crimson: #6D001A;
  --color-crimson-soft: #9B0827;
  --color-crimson-glow: #FF1744;

  /* Semantic Variables from :root */
  --color-text-primary: var(--text-primary);
  --color-text-secondary: var(--text-secondary);
  --color-text-muted: var(--text-muted);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-error: var(--error);
}

:root {
  /* Fonts mapping */
  --font-sans: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-display: 'Cabinet Grotesk', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
  /* Alias used by legacy components (chat, diagrams, setup) */
  --font-body: 'General Sans', 'Noto Sans Arabic', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* Scale tuning parameter (default 1, overridable via --p-scale) */
  --p-scale: 1;

  /* Type scale — 1.333 Modular Scale (Premium Hierarchy) scaled dynamically */
  --text-xs: calc(var(--p-scale, 1) * 0.75rem); /* 12px */
  --text-sm: calc(var(--p-scale, 1) * 0.875rem); /* 14px */
  --text-base: calc(var(--p-scale, 1) * 1rem); /* 16px */
  --text-md: calc(var(--p-scale, 1) * 1.333rem); /* 21px */
  --text-lg: calc(var(--p-scale, 1) * 1.777rem); /* 28px */
  
  /* Fluid scales for headlines to breathe across viewports (Bound max-size <= 2.5x min-size) scaled dynamically */
  --h3: clamp(calc(var(--p-scale, 1) * 1.25rem), calc(var(--p-scale, 1) * (1.5vw + 1rem)), calc(var(--p-scale, 1) * 1.75rem)); /* ~20px - ~28px */
  --h2: clamp(calc(var(--p-scale, 1) * 1.75rem), calc(var(--p-scale, 1) * (3vw + 1rem)), calc(var(--p-scale, 1) * 3.25rem));    /* ~28px - ~52px */
  --h1: clamp(calc(var(--p-scale, 1) * 2.25rem), calc(var(--p-scale, 1) * (6vw + 1rem)), calc(var(--p-scale, 1) * 4.5rem));     /* ~36px - ~72px */

  /* Colors - Dark theme (default) */
  --primary-bg: #0A0908;
  --secondary-bg: #0A0908;
  --card-bg: #121212;
  --modal-bg: #1a1a1a;
  --accent-primary: #b4ab8b;
  --accent-secondary: #b4ab8b;
  --accent-soft: rgb(180 171 139 / 10%);
  --text-primary: #fff;
  --text-secondary: #b0b0b0;
  --text-muted: #8c8c8c;
  --border-color: rgba(180, 171, 139, 0.15);
  --success: #4caf50;
  --warning: #ff9800;
  --error: #f44336;

  /* Overview palette */
  --color-dark: #0A0908;
  --color-crimson: #6d001a;
  --color-gold: #b4ab8b;
  --color-offwhite: #f5f1ec;

  /* Transitions */
  --transition-fast: 0.2s;
  --transition-normal: 0.3s;
  --transition-slow: 0.5s;
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-pop: ease-out;

  /* Spacing (4px base) scaled dynamically */
  --space-1: calc(var(--p-scale, 1) * 4px);
  --space-2: calc(var(--p-scale, 1) * 8px);
  --space-3: calc(var(--p-scale, 1) * 12px);
  --space-4: calc(var(--p-scale, 1) * 16px);
  --space-5: calc(var(--p-scale, 1) * 24px);
  --space-6: calc(var(--p-scale, 1) * 32px);
  --space-7: calc(var(--p-scale, 1) * 48px);
  --space-8: calc(var(--p-scale, 1) * 64px);
}

/* ── Typography Hierarchy (Class-Based) ── */
.display-h1,
.display-h2,
.display-h3,
.heading-display {
  font-family: var(--font-display);
  font-weight: 800;
  text-wrap: balance; /* Prevent awkward orphans in display headings */
}

.display-h1 {
  font-size: var(--h1);
  font-weight: 900;
  line-height: 1.1; /* Compensate line height slightly for light-on-dark display */
  letter-spacing: -0.01em; /* Increased spacing slightly for better readability */
}

.display-h2 {
  font-size: var(--h2);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.005em;
}

.display-h3 {
  font-size: var(--h3);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0;
}

html {
  font-family: var(--font-sans);
  font-feature-settings: 'cv11', 'ss01', 'ss03', 'cv02';
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Prevent flash */
html,
body {
  background-color: var(--primary-bg);
  min-height: 100%;
  margin: 0;
  padding: 0;
  font-family: var(--font-sans);
  font-weight: 400;
  line-height: 1.6;
  overflow-x: hidden;
}

.font-display {
  font-family: var(--font-display);
  letter-spacing: -0.01em;
}

.tabular {
  font-variant-numeric: tabular-nums;
}

p {
  max-width: 68ch; /* Optimal reading measure */
  text-wrap: pretty; /* Reduce orphans in paragraphs */
}

/* ── Shared setup wizard typography ── */
.setup-section-title {
  font-family: var(--font-display, sans-serif);
  font-size: 22px;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--text-primary, #fff);
  margin: 0;
}

.setup-section-subtitle {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.6;
  letter-spacing: 0.01em;
  color: var(--text-muted, #808080);
  margin: 6px 0 0;
}

#root {
  min-height: 100vh;
}

/* ── Dark Theme Scrollbar ── */
* {
  scrollbar-width: thin;
  scrollbar-color: #b4ab8b #1a1916;
}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #1a1916;
  border-radius: 0;
  padding: 2px;
}

::-webkit-scrollbar-thumb {
  background: #b4ab8b;
  border-radius: 10px;
  min-height: 30px;
}

::-webkit-scrollbar-thumb:hover {
  background: #b4ab8b;
}

::-webkit-scrollbar-thumb:active {
  background: #b4ab8b;
}

/* Hide scrollbar arrow buttons globally but keep scrollbar track/thumb visible */
/* stylelint-disable no-descending-specificity */
html::-webkit-scrollbar-button,
body::-webkit-scrollbar-button,
*::-webkit-scrollbar-button,
html::-webkit-scrollbar-button:single-button,
body::-webkit-scrollbar-button:single-button,
*::-webkit-scrollbar-button:single-button,
html::-webkit-scrollbar-button:start:decrement,
html::-webkit-scrollbar-button:end:increment,
body::-webkit-scrollbar-button:start:decrement,
body::-webkit-scrollbar-button:end:increment,
*::-webkit-scrollbar-button:start:decrement,
*::-webkit-scrollbar-button:end:increment,
html::-webkit-scrollbar-button:vertical:start:decrement,
html::-webkit-scrollbar-button:vertical:end:increment,
body::-webkit-scrollbar-button:vertical:start:decrement,
body::-webkit-scrollbar-button:vertical:end:increment,
*::-webkit-scrollbar-button:vertical:start:decrement,
*::-webkit-scrollbar-button:vertical:end:increment,
*::-webkit-scrollbar-button:vertical:decrement,
*::-webkit-scrollbar-button:vertical:increment,
*::-webkit-scrollbar-button:horizontal:decrement,
*::-webkit-scrollbar-button:horizontal:increment {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: 0 !important;
  max-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  box-shadow: none !important;
  content: none !important;
  background: transparent !important;
  background-image: none !important;
  appearance: none !important;
}

/* stylelint-enable no-descending-specificity */

/* Keep top-right corner clean when both axes are scrollable */
::-webkit-scrollbar-corner {
  background: #1a1916;
}


/* Global focus-visible ring for keyboard navigation */
:focus-visible {
  outline: 2px solid var(--accent-primary, #b4ab8b);
  outline-offset: 2px;
}

/* Utility: screen-reader only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border-width: 0;
}

/* ── Automated Scanner Overrides ── */
[data-sonner-toaster],
[data-sonner-toast],
[data-sonner-toast] * {
  transition-timing-function: ease-out !important;
}

[data-sonner-toast],
html [data-sonner-toaster] [data-sonner-toast],
html body [data-sonner-toaster] [data-sonner-toast] {
  transition: transform 0.3s ease-out, opacity 0.3s ease-out, box-shadow 0.3s ease-out !important;
}

[data-sonner-toaster],
html [data-sonner-toaster],
html body [data-sonner-toaster] {
  --front-transition:
    transform 0.3s ease-out, opacity 0.3s ease-out !important;
}

/* Hide native password reveal icons (e.g., Edge/Chrome) */
input[type="password"]::-ms-reveal,
input[type="password"]::-ms-clear,
input[type="password"]::-webkit-contacts-auto-fill-button {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}


/* ── Markdown Chat Styling (Legacy wrapper — do not add styles here) ──
 *
 * All markdown rendering is now handled by MarkdownRenderer.tsx and
 * its companion MarkdownRenderer.css (scoped under .md-root).
 *
 * The .markdown-body class is kept as a neutral passthrough container.
 * Do not add markdown-specific styles here; add them in MarkdownRenderer.css.
 * ─────────────────────────────────────────────────────────────────────────── */
.markdown-body {
  /* Neutral container — no font, color, or spacing overrides here.
   * The .md-root inside handles all rendering. */
  display: block;
  min-width: 0; /* Prevent flex child overflow */
  width: 100%;
}
